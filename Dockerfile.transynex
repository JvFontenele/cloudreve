# Cloudreve com a tarefa "Traduzir" (Transynex). Reaproveita o runtime da
# imagem oficial (aria2, ffmpeg, libreoffice...) e só troca o binário.
# Ao atualizar o Cloudreve, alinhe CLOUDREVE_VERSION com a tag rebaseada.
ARG CLOUDREVE_VERSION=4.19.1

FROM node:22 AS assets
ARG CLOUDREVE_VERSION
WORKDIR /src/assets
COPY assets/package.json assets/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 1000000
COPY assets/ ./
# Mesma versão do backend, senão o Cloudreve acusa "Static resource version mismatch"
RUN yarn version --new-version ${CLOUDREVE_VERSION}-transynex --no-git-tag-version \
    && NODE_OPTIONS=--max-old-space-size=8192 yarn run build

FROM golang:1.26-alpine AS backend
ARG CLOUDREVE_VERSION
RUN apk add --no-cache zip
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=assets /src/assets/build ./assets/build
RUN zip -qr - assets/build > application/statics/assets.zip \
    && CGO_ENABLED=0 go build -ldflags "-s -w -X 'github.com/cloudreve/Cloudreve/v4/application/constants.BackendVersion=${CLOUDREVE_VERSION}-transynex'" -o cloudreve

FROM cloudreve/cloudreve:${CLOUDREVE_VERSION}
COPY --from=backend /src/cloudreve /cloudreve/cloudreve
